TESTING=True
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=partification
POSTGRES_USER=partification
POSTGRES_PASSWORD=change-me-for-local-development
SECRET_KEY=replace-with-a-random-secret

# Local HTTP development. For production HTTPS, use true and __Host-session.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=session
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

LOGIN_RATE_LIMIT=5 per minute
PROTECTED_RATE_LIMIT=60 per minute
# In-memory counters are per process and reset on restart.
RATELIMIT_STORAGE_URI=memory://
